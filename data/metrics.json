      "thresholds": [
        {
          "field": "value",
          "operator": "lt",
          "value": 70,
          "severity": "critical",
          "label": "Below configured demo range"
        },
        {
          "field": "value",
          "operator": "gt",
          "value": 180,
          "severity": "critical",
          "label": "Above configured demo range"
        }
      ]
    },
