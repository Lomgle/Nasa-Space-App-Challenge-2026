{
  "categories": [
    "Cardiovascular",
    "Metabolic",
    "Core vitals",
    "Recovery",
    "Wellbeing",
    "Body composition",
    "Other"
  ],
  "metrics": [
    {
      "id": "blood-pressure",
      "name": "Blood pressure",
      "category": "Cardiovascular",
      "kind": "blood-pressure",
      "chartType": "line",
      "unit": "mmHg",
      "icon": "activity",
      "color": "blue",
      "subtitle": "Systolic / diastolic",
      "thresholds": [
        {
          "field": "systolic",
          "operator": "gte",
          "value": 140,
          "severity": "critical",
          "label": "Systolic above demo limit"
        },
        {
          "field": "diastolic",
          "operator": "gte",
          "value": 90,
          "severity": "critical",
          "label": "Diastolic above demo limit"
        },
        {
          "field": "systolic",
          "operator": "lt",
          "value": 90,
          "severity": "warning",
          "label": "Systolic below configured demo limit"
        },
        {
          "field": "diastolic",
          "operator": "lt",
          "value": 60,
          "severity": "warning",
          "label": "Diastolic below configured demo limit"
        }
      ]
    },
    {
      "id": "heart-rate",
      "name": "Heart rate",
      "category": "Cardiovascular",
      "kind": "number",
      "chartType": "line",
      "unit": "bpm",
      "icon": "heart",
      "color": "rose",
      "subtitle": "Resting pulse",
      "thresholds": [
        {
          "field": "value",
          "operator": "gt",
          "value": 110,
          "severity": "critical",
          "label": "Above configured demo limit"
        },
        {
          "field": "value",
          "operator": "lt",
          "value": 60,
          "severity": "warning",
          "label": "Below configured demo limit"
        }
      ]
    },
    {
